<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_view_inherit_wizard_form" model="ir.ui.view">
        <field name="name">studio.view.inherit.wizard.form</field>
        <field name="model">studio.view.inherit.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="base_view_id" options="{'no_create': True}"/>
                    <field name="model_name" invisible="1"/>
                    <field name="view_type" readonly="1"/>
                    <field name="name"/>
                </group>
                <group string="Dónde insertar">
                    <field name="anchor_field_id" options="{'no_create': True}"/>
                    <field name="xpath_expr" placeholder="//field[@name='partner_id']"/>
                    <field name="position"/>
                </group>
                <group string="Qué insertar">
                    <field name="content" nolabel="1" widget="ace" options="{'mode': 'xml'}"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Crear vista heredada" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_view_inherit_wizard" model="ir.actions.act_window">
        <field name="name">Heredar una Vista o Reporte (xpath)</field>
        <field name="res_model">studio.view.inherit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
