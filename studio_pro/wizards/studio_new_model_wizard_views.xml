<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_new_model_wizard_form" model="ir.ui.view">
        <field name="name">studio.new.model.wizard.form</field>
        <field name="model">studio.new.model.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="app_id" options="{'no_create': True}"/>
                    <field name="name" placeholder="ej: Equipo"/>
                    <field name="technical_name_preview"/>
                </group>
                <group string="Campos incorporados">
                    <field name="has_active_field"/>
                    <field name="has_sequence_field"/>
                    <field name="has_description_field"/>
                </group>
                <group string="Comunicación">
                    <field name="has_chatter"/>
                    <field name="has_activities" invisible="not has_chatter"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Crear modelo" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_new_model_wizard" model="ir.actions.act_window">
        <field name="name">Nuevo modelo</field>
        <field name="res_model">studio.new.model.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
