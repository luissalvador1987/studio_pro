<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_export_wizard_form" model="ir.ui.view">
        <field name="name">studio.export.wizard.form</field>
        <field name="model">studio.export.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-warning" role="alert">
                    Exporta modelos, campos personalizados, vistas, menús, grupos y permisos de acceso como un
                    módulo de Odoo real e instalable. Las automatizaciones y los reportes generados permanecen
                    en esta base de datos y (todavía) no se recrean en la exportación.
                </div>
                <group>
                    <field name="app_id" options="{'no_create': True}" readonly="state == 'done'"/>
                    <field name="module_name" readonly="state == 'done'"/>
                </group>
                <field name="file_data" filename="file_name" invisible="state != 'done'"/>
                <field name="file_name" invisible="1"/>
                <footer>
                    <button name="action_generate" type="object" string="Generar módulo" class="btn-primary"
                            invisible="state == 'done'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_export_wizard" model="ir.actions.act_window">
        <field name="name">Exportar App como módulo</field>
        <field name="res_model">studio.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
