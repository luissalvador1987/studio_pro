<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_record_rule_wizard_form" model="ir.ui.view">
        <field name="name">studio.record.rule.wizard.form</field>
        <field name="model">studio.record.rule.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="name"/>
                    <field name="model_id" options="{'no_create': True}"/>
                    <field name="group_ids" widget="many2many_tags"
                           placeholder="Vacío = todos los usuarios"/>
                </group>
                <group string="Qué registros puede ver/tocar">
                    <field name="preset"/>
                    <field name="owner_field_id" options="{'no_create': True}"
                           invisible="preset != 'own_records'"/>
                    <field name="domain_force" readonly="preset != 'custom'"/>
                </group>
                <group string="Permisos que aplica esta regla">
                    <field name="perm_read"/>
                    <field name="perm_write"/>
                    <field name="perm_create"/>
                    <field name="perm_unlink"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Crear regla" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_record_rule_wizard" model="ir.actions.act_window">
        <field name="name">Nueva Regla de Registro</field>
        <field name="res_model">studio.record.rule.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
