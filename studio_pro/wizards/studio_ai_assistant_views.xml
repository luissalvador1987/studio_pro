<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_ai_assistant_wizard_form" model="ir.ui.view">
        <field name="name">studio.ai.assistant.wizard.form</field>
        <field name="model">studio.ai.assistant.wizard</field>
        <field name="arch" type="xml">
            <form>
                <div class="alert alert-info" role="alert">
                    Describe lo que necesitas en lenguaje simple. El asistente solo propone un plan —
                    revísalo y haz clic en "Aplicar" tú mismo; nada se crea automáticamente.
                </div>
                <group>
                    <field name="app_id" options="{'no_create': True}"/>
                    <field name="prompt" placeholder="ej: Agrega un campo 'Fecha de fin de garantía' en el modelo Equipo, y detén el flujo a menos que el estado del equipo sea 'activo'." readonly="state != 'draft'"/>
                </group>
                <field name="error_message" invisible="not error_message" class="text-danger"/>
                <group string="Plan propuesto" invisible="state == 'draft'">
                    <field name="plan_preview" nolabel="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_generate_plan" type="object" string="Preguntar a la IA" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_apply_plan" type="object" string="Aplicar plan" class="btn-primary"
                            invisible="state != 'previewed'"/>
                    <button string="Cerrar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_ai_assistant_wizard" model="ir.actions.act_window">
        <field name="name">Asistente de IA</field>
        <field name="res_model">studio.ai.assistant.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
