<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_new_view_wizard_form" model="ir.ui.view">
        <field name="name">studio.new.view.wizard.form</field>
        <field name="model">studio.new.view.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="app_id"/>
                    <field name="res_model_id" options="{'no_create': True}"/>
                    <field name="res_model_name" invisible="1"/>
                    <field name="view_type"/>
                    <field name="name" placeholder="ej: Vista Kanban de Equipos"/>
                </group>
                <footer>
                    <button name="action_create" type="object" string="Crear vista" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_studio_new_view_wizard" model="ir.actions.act_window">
        <field name="name">Nueva vista</field>
        <field name="res_model">studio.new.view.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
