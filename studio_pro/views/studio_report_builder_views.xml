<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_report_builder_list" model="ir.ui.view">
        <field name="name">studio.report.builder.list</field>
        <field name="model">studio.report.builder</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="view_studio_report_builder_form" model="ir.ui.view">
        <field name="name">studio.report.builder.form</field>
        <field name="model">studio.report.builder</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generar / Actualizar reporte" class="btn-primary"/>
                    <button name="action_print" type="object" string="Vista previa de impresión" class="btn-secondary"
                            invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ej: Lista de Equipos"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="app_id"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="title"/>
                        </group>
                        <group>
                            <field name="orientation"/>
                            <field name="group_by_field_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="field_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_studio_report_builder" model="ir.actions.act_window">
        <field name="name">Reportes</field>
        <field name="res_model">studio.report.builder</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer reporte</p>
        </field>
    </record>
</odoo>
