<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_dashboard_list" model="ir.ui.view">
        <field name="name">studio.dashboard.list</field>
        <field name="model">studio.dashboard</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="model_id"/>
                <field name="state" widget="badge" decoration-success="state == 'generated'"/>
            </list>
        </field>
    </record>

    <record id="view_studio_dashboard_form" model="ir.ui.view">
        <field name="name">studio.dashboard.form</field>
        <field name="model">studio.dashboard</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_generate" type="object" string="Generar / Actualizar tablero" class="btn-primary"/>
                    <button name="action_open" type="object" string="Abrir tablero" class="btn-secondary"
                            invisible="state != 'generated'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,generated"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="ej: Ventas por vendedor"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="app_id"/>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="domain"/>
                        </group>
                        <group>
                            <field name="measure_field_id"/>
                            <field name="groupby_field_id"/>
                        </group>
                    </group>
                    <group string="Tipos de vista a incluir">
                        <field name="has_graph"/>
                        <field name="graph_type" invisible="not has_graph"/>
                        <field name="has_pivot"/>
                        <field name="has_list"/>
                        <field name="has_kanban"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_studio_dashboard" model="ir.actions.act_window">
        <field name="name">Tableros</field>
        <field name="res_model">studio.dashboard</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Crea tu primer tablero</p>
            <p>Gráficos, tablas dinámicas, kanban o listas sobre cualquier modelo — estándar, de otro addon,
               o creado con Studio Pro — usando siempre el ORM seguro de Odoo (nunca SQL directo).</p>
        </field>
    </record>
</odoo>
