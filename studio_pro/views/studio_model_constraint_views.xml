<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_studio_model_constraint_list" model="ir.ui.view">
        <field name="name">studio.model.constraint.list</field>
        <field name="model">studio.model.constraint</field>
        <field name="arch" type="xml">
            <list>
                <field name="model_name"/>
                <field name="name"/>
                <field name="constraint_type"/>
                <field name="state" widget="badge" decoration-success="state == 'applied'"/>
            </list>
        </field>
    </record>

    <record id="view_studio_model_constraint_form" model="ir.ui.view">
        <field name="name">studio.model.constraint.form</field>
        <field name="model">studio.model.constraint</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_apply" type="object" string="Aplicar en la base de datos"
                            class="btn-primary" invisible="state == 'applied'"/>
                    <button name="action_remove" type="object" string="Quitar de la base de datos"
                            invisible="state != 'applied'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="model_id" options="{'no_create': True}"/>
                            <field name="name" readonly="state == 'applied'"/>
                            <field name="sql_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="constraint_type" readonly="state == 'applied'"/>
                            <field name="field_ids" widget="many2many_tags"
                                   invisible="constraint_type != 'unique'" readonly="state == 'applied'"/>
                            <field name="check_expression" invisible="constraint_type != 'check'"
                                   readonly="state == 'applied'"/>
                            <field name="message"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_studio_model_constraint" model="ir.actions.act_window">
        <field name="name">Restricciones (Constraints)</field>
        <field name="res_model">studio.model.constraint</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Define una restricción Única o de Condición sobre un modelo creado con Studio
                Pro, y aplícala directamente en la base de datos.
            </p>
        </field>
    </record>
</odoo>
