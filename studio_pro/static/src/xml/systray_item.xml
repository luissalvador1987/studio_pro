<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="studio_pro.SystrayItem">
        <div class="o_studio_pro_systray_item d-flex align-items-center" t-if="state.allowed">
            <Dropdown>
                <button class="btn position-relative" title="Studio Pro">
                    <i class="fa fa-magic"/>
                </button>
                <t t-set-slot="content">
                    <DropdownItem onSelected.bind="onEditCurrentView">
                        Editar esta vista con Studio Pro
                    </DropdownItem>
                    <DropdownItem onSelected.bind="onOpenApp">
                        Abrir Studio Pro
                    </DropdownItem>
                </t>
            </Dropdown>
        </div>
    </t>

</templates>
